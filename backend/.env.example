NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
# Banco local separado; preencha com valores próprios. Não use dados de produção em testes.
POSTGRES_DB=dsaol_dev
POSTGRES_USER=dsaol_local
POSTGRES_PASSWORD=SUBSTITUA_POR_UM_SEGREDO_LOCAL
DATABASE_URL=postgresql://dsaol_local:SUBSTITUA_POR_UM_SEGREDO_LOCAL@127.0.0.1:5433/dsaol_dev
TEST_DATABASE_URL=postgresql://dsaol_local:SUBSTITUA_POR_UM_SEGREDO_LOCAL@127.0.0.1:5433/dsaol_test
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_DE_PELO_MENOS_64_CARACTERES
TRUST_PROXY=0
# local: mensagens privadas em backend/.mail; smtp: entrega real configurada abaixo
EMAIL_TRANSPORT=file
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# O formulário WhatsApp funciona mesmo com esta integração desativada.
CONTACT_REQUESTS_ENABLED=false
