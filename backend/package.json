{
  "name": "dsaol-backend",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node --env-file=.env src/server.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file=.env prisma/seed.js",
    "admin:bootstrap": "node --env-file=.env scripts/bootstrap-admin.js",
    "test": "node --env-file=.env --test --test-concurrency=1 tests/*.test.js",
    "test:unit": "node --test tests/unit.test.js",
    "test:integration": "node --env-file=.env --test tests/integration.test.js",
    "db:migrate:test": "node --env-file=.env scripts/migrate-test.js",
    "test:schema": "node --env-file=.env --test tests/schema.test.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "connect-pg-simple": "10.0.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "supertest": "7.3.1"
  }
}
